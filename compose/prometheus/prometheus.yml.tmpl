# ==============================================================================
# Description: Prometheus configuration template for metrics collection.
#   This template is processed by the entrypoint script to generate the final
#   prometheus.yml with optional remote_write configuration based on
#   REMOTE_WRITE_URL environment variable.
# Author: Infrastructure Team
# Usage: Processed by compose/prometheus/entrypoint.sh at container startup
# Dependencies: prom/prometheus:v2.47
# ==============================================================================

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'observability-stack'
    environment: '${ENVIRONMENT:-production}'

alerting:
  alertmanagers:
    - static_configs:
        - targets: []

rule_files: []

scrape_configs:
  # Prometheus self-monitoring
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Node Exporter for host-level metrics
  - job_name: 'node-exporter'
    static_configs:
      - targets: ['node-exporter:9100']

  # PostgreSQL Exporter for database metrics
  - job_name: 'postgres-exporter'
    static_configs:
      - targets: ['postgres-exporter:9187']

  # Grafana metrics
  - job_name: 'grafana'
    static_configs:
      - targets: ['grafana:3000']

  # Application metrics (if app exposes /metrics)
  - job_name: 'app'
    static_configs:
      - targets: ['app:80']
    metrics_path: '/metrics'

  # Traefik metrics
  - job_name: 'traefik'
    static_configs:
      - targets: ['traefik:8081']

  # Cadvisor for container metrics (if enabled)
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']

{{- if .RemoteWriteURL }}
remote_write:
  - url: "{{ .RemoteWriteURL }}"
    {{- if .RemoteWriteHeaders }}
    headers:
      {{- range $key, $value := .RemoteWriteHeaders }}
      {{ $key }}: "{{ $value }}"
      {{- end }}
    {{- end }}
    {{- if .RemoteWriteBasicAuth }}
    basic_auth:
      username: "{{ .RemoteWriteBasicAuth.Username }}"
      password: "{{ .RemoteWriteBasicAuth.Password }}"
    {{- end }}
    {{- if .RemoteWriteTLSConfig }}
    tls_config:
      {{- if .RemoteWriteTLSConfig.InsecureSkipVerify }}
      insecure_skip_verify: {{ .RemoteWriteTLSConfig.InsecureSkipVerify }}
      {{- end }}
      {{- if .RemoteWriteTLSConfig.CAFile }}
      ca_file: "{{ .RemoteWriteTLSConfig.CAFile }}"
      {{- end }}
      {{- if .RemoteWriteTLSConfig.CertFile }}
      cert_file: "{{ .RemoteWriteTLSConfig.CertFile }}"
      {{- end }}
      {{- if .RemoteWriteTLSConfig.KeyFile }}
      key_file: "{{ .RemoteWriteTLSConfig.KeyFile }}"
      {{- end }}
    {{- end }}
{{- end }}