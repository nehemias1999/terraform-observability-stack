# ==============================================================================
# Description: Environment variable template for the observability stack
#   Docker Compose configuration. Copy this file to .env and fill in
#   the values before running docker compose up.
# Author: Infrastructure Team
# Usage: cp .env.example .env && edit .env
# ==============================================================================

# ==============================================================================
# DOMAIN CONFIGURATION
# ==============================================================================
# Base domain for Traefik routing (e.g., example.com)
# Services will be available at: traefik.example.com, grafana.example.com, etc.
DOMAIN=localhost

# ==============================================================================
# TRAEFIK CONFIGURATION
# ==============================================================================
# Email for Let's Encrypt ACME certificate registration (required for TLS)
TRAEFIK_ACME_EMAIL=admin@example.com

# Traefik Dashboard Basic Auth (optional but recommended)
# If set, protects the Traefik dashboard with basic authentication
# TRAEFIK_DASHBOARD_USER=admin
# TRAEFIK_DASHBOARD_PASSWORD=secure-password
# Note: Password will be bcrypt-hashed at startup. For production, pre-generate
# hash with: htpasswd -nbB -C 12 username password

# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================
# Database name
POSTGRES_DB=observability

# Database user
POSTGRES_USER=observability

# Database password (REQUIRED - must be set, no default for security)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ==============================================================================
# GRAFANA CONFIGURATION
# ==============================================================================
# Admin username for Grafana
GRAFANA_ADMIN_USER=admin

# Admin password for Grafana (REQUIRED - must be set, no default for security)
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=

# Comma-separated list of Grafana plugins to install on startup
# Example: grafana-piechart-panel,grafana-worldmap-panel
GRAFANA_PLUGINS=

# ==============================================================================
# ENVIRONMENT METADATA
# ==============================================================================
# Environment name (production, staging, development)
ENVIRONMENT=production

# ==============================================================================
# PROMETHEUS CONFIGURATION
# ==============================================================================
# Scrape interval for metrics collection (default: 15s)
# PROMETHEUS_SCRAPE_INTERVAL=15s

# Retention period for metrics data (default: 15d)
# PROMETHEUS_RETENTION=15d

# ==============================================================================
# PROMETHEUS REMOTE WRITE (optional)
# ==============================================================================
# URL for Prometheus remote write (e.g., Thanos, Cortex, Grafana Cloud)
# If set, enables remote_write in Prometheus configuration
# REMOTE_WRITE_URL=https://remote-prometheus.example.com/api/v1/write

# Authentication for remote write (choose ONE method):
# Bearer token authentication
# REMOTE_WRITE_AUTHORIZATION=your-bearer-token

# Basic authentication
# REMOTE_WRITE_BASIC_AUTH_USER=username
# REMOTE_WRITE_BASIC_AUTH_PASSWORD=password

# Custom headers (comma-separated Key:Value pairs)
# REMOTE_WRITE_HEADER_CONTENT_TYPE=application/json
# REMOTE_WRITE_HEADER_CUSTOM=X-Custom-Header:Value

# TLS configuration for remote write
# REMOTE_WRITE_TLS_INSECURE_SKIP_VERIFY=true
# REMOTE_WRITE_TLS_CA_FILE=/etc/prometheus/ca.crt
# REMOTE_WRITE_TLS_CERT_FILE=/etc/prometheus/client.crt
# REMOTE_WRITE_TLS_KEY_FILE=/etc/prometheus/client.key

# ==============================================================================
# CLOUD PROVIDER SPECIFIC (optional, for reference)
# ==============================================================================
# AWS Configuration
# AWS_REGION=us-east-1
# AWS_VPC_ID=vpc-xxxxxxx
# AWS_SUBNET_ID=subnet-xxxxxxx
# AWS_AMI_ID=ami-xxxxxxx

# GCP Configuration
# GCP_PROJECT_ID=my-project
# GCP_REGION=us-central1
# GCP_IMAGE_FAMILY=ubuntu-2204-lts